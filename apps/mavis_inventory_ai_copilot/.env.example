APP_ENV=development
# Use "local" for offline demo; use "openai" with OPENAI_API_KEY for LLM summaries
# Put secrets in .env.local (gitignored) at repo root or in this app folder
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEFAULT_DATA_SOURCE=data/raw/Inventory_IT_Asset_Control_Toolkit.xlsx
